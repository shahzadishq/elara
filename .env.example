# Public site URL (enables canonical URL, Open Graph URLs/images, structured-data URL).
# Leave empty until the final domain is known.
NEXT_PUBLIC_SITE_URL=

# Optional external booking URL (e.g. Doctolib). Empty = all "Termin vereinbaren"
# buttons scroll to the enquiry form.
NEXT_PUBLIC_BOOKING_URL=

# Google Tag Manager container ID (GTM-XXXXXXX). Empty = no consent banner, no tracking scripts.
# When set, GTM loads only after the visitor clicks "Akzeptieren".
NEXT_PUBLIC_GTM_ID=

# Enquiry form delivery – configure ONE option. Without it the form shows an error
# (it never reports a fake success).
# Option A: e-mail via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Option B: POST the enquiry as JSON to a webhook (Make, Zapier, n8n, own backend …)
CONTACT_WEBHOOK_URL=

# Set to 1 on a preview deployment to highlight content that still needs client confirmation.
NEXT_PUBLIC_REVIEW_MODE=
